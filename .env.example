# Copy to .env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------------
DOMAIN=money.example.com
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me-long-random
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Friends need this code to create an account. Leave empty to allow anyone (not recommended).
INVITE_CODE=
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGINS=
MAX_UPLOAD_MB=10

# --- Receipt extraction -------------------------------------------------------
# gemini | ollama (any OpenAI-compatible endpoint) | mock (fixture data, for testing only)
EXTRACTOR_PROVIDER=gemini

# Gemini. Free tier: prompts may be used to improve Google's models, and no commercial use.
# Friends' receipts are their financial data, so tell them which provider you use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no thinking (faster, avoids truncated JSON). Leave empty for models that reject thinkingConfig.
GEMINI_THINKING_BUDGET=0

# Ollama / LM Studio / vLLM / OpenRouter
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5vl:7b
# json_object works everywhere; json_schema is stricter where supported.
OPENAI_JSON_MODE=json_object

# Calls are spaced evenly; free tiers break on per-minute limits first.
LLM_REQUESTS_PER_MINUTE=10
# Local models on CPU are slow.
LLM_TIMEOUT_SECS=180
MAX_ATTEMPTS=3
# Fields below this confidence are highlighted for review.
REVIEW_CONFIDENCE_THRESHOLD=0.75
